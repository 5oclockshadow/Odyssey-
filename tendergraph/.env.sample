# TenderGraph autonomous harness — copy to .env and edit.
TENDER_PORT=9905
TENDER_HOST=0.0.0.0
TENDER_STATE=./state
TENDER_INTERVAL_S=900
TENDER_AUTO_ENABLED=true       # full-auto from env (pause-only; TENDER_AUTO_KILL=1 hard-stops)
# Reuse the fleet router / DMR for structured reasoning (optional; engine runs offline)
ROUTER_BASE=http://192.168.1.204:8776/v1
DMR_BASE_URL=http://localhost:12434/engines/v1
