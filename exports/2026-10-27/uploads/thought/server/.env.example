PORT=8787
PUBLIC_URL=https://example.com      # used in referral links inside emails
DB_FILE=./mapgraph.db
ADMIN_TOKEN=                        # REQUIRED, 24+ random chars (openssl rand -hex 24). Server refuses to start without it.
TRUST_PROXY=0                       # 1 only behind a proxy you control (uses X-Forwarded-For for rate limits)
NODE_ENV=production
CORS_ORIGIN=                        # leave empty to allow any origin, or set your site origin
SERVE_STATIC=1                      # 0 = API only
SMTP_URL=                           # smtp://user:pass@host:587  (empty = dry-run to the console)
MAIL_FROM=Map Graph <hello@example.com>
