# Copy to .env and fill in. Nothing here is required to run the test suite
# (tests use dspy.utils.dummies.DummyLM and a local file-backed store), only
# to run the agent against a real LM / real Redis / real Phoenix.

# --- Workbench (python -m selfwire.workbench / docker compose) ---
# Required whenever the workbench binds anything other than 127.0.0.1
# (docker compose does): it can edit files and run code. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
SELFWIRE_WORKBENCH_TOKEN=
# Which model the agent chat and the improvement loop use (any litellm id).
# You can also set or change it at runtime from the dashboard's Settings.
# SELFWIRE_LM_MODEL=anthropic/claude-sonnet-4-5
# SELFWIRE_LM_API_KEY=          # held in memory only; or use the provider var below
# SELFWIRE_LM_API_BASE=
# SELFWIRE_MAX_ITERS=8

# --- LM credentials (litellm reads these directly) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- storage.py: RaptorRedisStore ---
# Falls back automatically (raptor -> raw -> file) if unset/unreachable.
RAPTOR_REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# --- telemetry.py: Phoenix tracing (opt-in; off by default) ---
SELFWIRE_ENABLE_PHOENIX=0
PHOENIX_COLLECTOR_ENDPOINT=localhost:4317
