# the model named in apps/engine/institute.yaml (Sonnet) and the ops agent's (OPS_MODEL, default Haiku). Both read this one key.
ANTHROPIC_API_KEY=
OPS_MODEL=anthropic/claude-haiku-4-5

# development simulates the outside world with a DSPy world-agent (nothing it writes is ever published); production reads only the real feeds
THRESHOLD_ENV=development

# the owner: login on /terminal. OWNER_PASSWORD, or OWNER_PASSWORD_HASH = sha256 hex of the password. SESSION_SECRET signs the cookie (any long random string)
OWNER_PASSWORD=
SESSION_SECRET=

# shared secrets between the engine and the services it starts in its own docker: any long random strings
HUB_TOKEN=
REDIS_PASSWORD=

# GitHub: reading through the hub, and pull requests / issues for repairs and approved upgrades. GITHUB_REPO = owner/name
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_REPO=

# Slack: reading through the hub (SLACK_BOT_TOKEN + SLACK_TEAM_ID) and mindful posting (chat:write; SLACK_CHANNEL optional)
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL=
# X
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# LinkedIn (Community Management API, w_member_social)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:XXXX
# Reddit (script app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# tools behind the MCP hub
WOLFRAM_API_KEY=
APIFY_TOKEN=

# TESTER (apps/tester): the token for its write routes (run, fix, apply, ask; any long random string; one is generated into its state if empty),
# its model (reads ANTHROPIC_API_KEY above) and whether verified fixes wait for you (propose) or are written to the repository (auto)
TESTER_TOKEN=
TESTER_MODEL=anthropic/claude-sonnet-4-5
TESTER_APPLY=propose

# TESTER's build loop (apps/tester/build.py). It reaches SEXTANT by signing a five-minute build token with SESSION_SECRET above for the engine's
# POST /builder/say; SEXTANT_TOKEN (an owner session, twelve hours) is only the fallback. TESTER_EDIT=on lets passing repos land in repos/.
# BUILD_AUTOSTART: resume (start again a run the container stopped in), on, off. INSTITUTE_SITE / INSTITUTE_GRAPH override the links in
# repos/registry.json that every README carries.
TESTER_EDIT=off
BUILD_AUTOSTART=resume
BUILD_ROUNDS=
SEXTANT_URL=http://agent:8000
SEXTANT_TOKEN=
INSTITUTE_SITE=
INSTITUTE_GRAPH=

# the substrate ladder behind /v1/ask (apps/engine/rungs.py): OpenAI-compatible servers below the configured model, cheapest first, as
# name=url#model with names from graph, lstm, tiny, 1-3b, 8b, 30b. RUNG_TOP is the configured model's rung (on = 30b) or off.
RUNG_SERVERS=
RUNG_KEY=
RUNG_TOP=on
